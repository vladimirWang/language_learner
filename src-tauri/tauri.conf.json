{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Word Adventure",
  "version": "0.1.0",
  "identifier": "com.wordadventure.game",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Word Adventure · 单词乐园",
        "width": 1180,
        "height": 840,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#FFFBF3"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
